{
  "name": "autocat-app",
  "productName": "AutoCAT",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for the AutoCAT collection covers and catalogs. Web UI, wrapped by Electron \u2014 the same UI ports to Android TV via Capacitor.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node ../scripts/start-desktop.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cd android && sh ./gradlew assembleDebug",
    "android:apk": "cd android && sh ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "electron": "^31.2.0"
  },
  "allowScripts": {
    "electron": true
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "webtorrent": "^2.8.5"
  },
  "overrides": {
    "uint8-util": "2.2.6"
  }
}
