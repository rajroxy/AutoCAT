# Secrets — managed via Settings → Environment, never committed
.env
.env.local
.env.*.local

# Runtime settings written by the app (may contain provider API keys)
addon/settings.json

# Runtime state written by the app (your pinned titles, not source)
addon/watchlist.json

# The account this machine signed in with — a name and an optional address, no password.
# Private to the install, and not source.
addon/account.json

# Live TV's parsed playlist + guide (runtime cache, not source)
addon/live-cache.json

# Dependencies
node_modules/
scripts/node_modules/

# Android build output — the Capacitor project itself IS committed.
# `app/src/main/assets/public` is regenerated from desktop/ui by `npm run android:sync`.
desktop/android/.gradle/
desktop/android/build/
desktop/android/app/build/
desktop/android/local.properties
desktop/android/app/src/main/assets/public/

# OS noise
.DS_Store

# Scratch used while working on the app's live preview: server logs and the one-off
# render/check scripts. Nothing here is part of the app.
.preview/

# Scraper sessions — cookies earned while extracting, runtime state not source
scraper/sessions.json

# Scraper plugins — pasted by the user at runtime, not source
scraper/plugins.json

# Custom Websites — the sites this user added, with their detected search forms.
# Private to the install, and not source.
addon/custom-sites.json

# Repository list — the repositories this user subscribed to, by name
addon/repositories.json

# DNS — which resolver this install asked, and whether the override was on
addon/dns-config.json

# General preferences written by the app (search-on-play, the summary line, …)
addon/user-preferences.json

# **Per-profile stores and their marker.** The watchlist and the Library are one file per
# profile now (`watchlist.<who>.json`, `customrows.<who>.json`); the `.scope` marker records
# which profile inherited the pre-scope file, so a second profile never copies the first's.
addon/watchlist.*.json
addon/customrows.*.json
addon/watchlist.scope
addon/customrows.scope

# **The settings are per profile too.** `settings.<who>.json` holds that profile's keys,
# add-ons, live source and trackers, and `settings.scope` records which profile inherited
# the pre-scope file. Both are runtime state, and neither is source.
addon/settings.*.json
addon/settings.scope

# **Every store is one file per profile now, not just the watchlist.** The saved sites,
# the resolver and the general preferences follow the same shape, with the same marker
# recording which profile inherited the pre-scope file — and the same one-time
# `settings.split.<who>` marker, which records that a profile has been checked for a
# copy of another profile's settings. All runtime state, none of it source.
addon/custom-sites.*.json
addon/repositories.*.json
addon/dns-config.*.json
addon/user-preferences.*.json
addon/custom-sites.scope
addon/repositories.scope
addon/dns-config.scope
addon/user-preferences.scope
addon/settings.split.*
.tmp/
serve.log
.patch/
serve.pid
