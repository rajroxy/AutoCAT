{
  "name": "autocat-collection-covers",
  "description": "Landscape (16:9) cover art for every AutoCAT collection \u2014 animated SVG masters and 1920x1080 PNG exports.",
  "private": true,
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "start:web": "node serve.mjs",
    "desktop:install": "node scripts/start-desktop.mjs --install-only",
    "preview": "node serve.mjs",
    "generate": "cd scripts && npm install && npm run generate",
    "vendor:hls": "node --input-type=module -e \"import fs from 'node:fs';fs.copyFileSync('desktop/node_modules/hls.js/dist/hls.min.js','desktop/ui/vendor/hls.min.js')\"",
    "vendor:webtorrent": "node --input-type=module -e \"import fs from 'node:fs';fs.copyFileSync('desktop/node_modules/webtorrent/dist/webtorrent.min.js','desktop/ui/vendor/webtorrent.min.js')\"",
    "icon": "node scripts/generate-icon.mjs"
  },
  "type": "module",
  "dependencies": {
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "webtorrent": "^2.8.5",
    "cheerio": "^1.0.0",
    "crypto-js": "^4.2.0",
    "torrent-stream": "^1.2.1"
  },
  "overrides": {
    "uint8-util": "2.2.6"
  },
  "devDependencies": {
    "sharp": "^0.34.0"
  }
}
